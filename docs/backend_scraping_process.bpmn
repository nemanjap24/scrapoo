<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Backend_Scraping_Process" targetNamespace="https://scrapoo.local/bpmn/backend-scraping" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <bpmn:process id="Process_Backend_Scraping" name="Backendový proces zberu údajov" isExecutable="false">
    <bpmn:documentation>
      Backendový BPMN proces pre zber údajov z ČSFD. Proces sleduje skutočný tok aplikácie:
      FastAPI prijme požiadavku na zber údajov, vyrieši URL adresy máp stránok, zaradí úlohu Celery do frontu,
      worker na pozadí rozbalí URL adresy filmov, spustí dávky Scrapy, uloží údaje cez Tortoise ORM
      a sprístupní konečný stav úlohy.
    </bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Backend_Scraping">
      <bpmn:lane id="Lane_Persistence" name="Persistence layer">
        <bpmn:flowNodeRef>Task_Persist_Data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Update_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Scraping_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Worker" name="Background worker">
        <bpmn:flowNodeRef>Task_Expand_Film_Urls</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Skip_Existing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Filter_Existing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Collect_Results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Crawl_Chunks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Create_Chunks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1y6lyrq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Queue" name="Task queue">
        <bpmn:flowNodeRef>Task_Deliver_Task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Store_Queued_Task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enqueue_Celery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0ocreo2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_API" name="API služba">
        <bpmn:flowNodeRef>Task_Validate_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Resolve_Sitemaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Return_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Return_Task_Id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Scrape_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Request_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Request_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Sitemaps_Found</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Scrape_Request" name="POST /movies/scrape">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Validate_Request" name="Validovať parametre zberu údajov">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Resolve_Sitemaps" name="Vyhľadať vybrané mapy stránok ČSFD">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Sitemaps_Found" name="Mapy stránok nájdené?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4a</bpmn:outgoing>
      <bpmn:outgoing>Flow_4b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Return_Error" name="Vrátiť chybu 404/502">
      <bpmn:incoming>Flow_4b</bpmn:incoming>
      <bpmn:outgoing>Flow_5b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Request_Rejected" name="Požiadavka zamietnutá">
      <bpmn:incoming>Flow_5b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Enqueue_Celery" name="Zaradiť úlohu zberu údajov do frontu">
      <bpmn:incoming>Flow_4a</bpmn:incoming>
      <bpmn:outgoing>Flow_0v9t1jd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Return_Task_Id" name="Vrátiť prijatú odpoveď s ID úlohy">
      <bpmn:incoming>Flow_0bnqrih</bpmn:incoming>
      <bpmn:outgoing>Flow_6a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Request_Accepted" name="HTTP požiadavka prijatá">
      <bpmn:incoming>Flow_6a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Store_Queued_Task" name="Uložiť úlohu v sprostredkovateľovi Redis">
      <bpmn:incoming>Flow_1717vq2</bpmn:incoming>
      <bpmn:outgoing>Flow_6_queue</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Deliver_Task" name="Doručiť úlohu workeru">
      <bpmn:incoming>Flow_6_queue</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Expand_Film_Urls" name="Rozbaliť mapy stránok na URL filmov">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Skip_Existing" name="Preskočiť existujúce filmy?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9a</bpmn:outgoing>
      <bpmn:outgoing>Flow_9b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Filter_Existing" name="Filtrovať už uložené URL adresy">
      <bpmn:incoming>Flow_9a</bpmn:incoming>
      <bpmn:outgoing>Flow_052ambf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Create_Chunks" name="Rozdeliť URL filmov na dávky">
      <bpmn:incoming>Flow_1el5msz</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Crawl_Chunks" name="Spustiť dávky Scrapy">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Collect_Results" name="Zozbierať získané filmy a osoby">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Persist_Data" name="Uložiť filmy, osoby a vzťahy">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Update_Status" name="Aktualizovať výsledok úlohy Celery">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Scraping_Completed" name="Úloha zberu údajov dokončená">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Scrape_Request" targetRef="Task_Validate_Request" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Validate_Request" targetRef="Task_Resolve_Sitemaps" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Resolve_Sitemaps" targetRef="Gateway_Sitemaps_Found" />
    <bpmn:sequenceFlow id="Flow_4a" name="áno" sourceRef="Gateway_Sitemaps_Found" targetRef="Task_Enqueue_Celery" />
    <bpmn:sequenceFlow id="Flow_4b" name="nie" sourceRef="Gateway_Sitemaps_Found" targetRef="Task_Return_Error" />
    <bpmn:sequenceFlow id="Flow_5b" sourceRef="Task_Return_Error" targetRef="End_Request_Rejected" />
    <bpmn:sequenceFlow id="Flow_6a" sourceRef="Task_Return_Task_Id" targetRef="End_Request_Accepted" />
    <bpmn:sequenceFlow id="Flow_6_queue" sourceRef="Task_Store_Queued_Task" targetRef="Task_Deliver_Task" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Deliver_Task" targetRef="Task_Expand_Film_Urls" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Expand_Film_Urls" targetRef="Gateway_Skip_Existing" />
    <bpmn:sequenceFlow id="Flow_9a" name="áno" sourceRef="Gateway_Skip_Existing" targetRef="Task_Filter_Existing" />
    <bpmn:sequenceFlow id="Flow_9b" name="nie" sourceRef="Gateway_Skip_Existing" targetRef="Gateway_1y6lyrq" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Create_Chunks" targetRef="Task_Crawl_Chunks" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Crawl_Chunks" targetRef="Task_Collect_Results" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Collect_Results" targetRef="Task_Persist_Data" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Persist_Data" targetRef="Task_Update_Status" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Update_Status" targetRef="End_Scraping_Completed" />
    <bpmn:parallelGateway id="Gateway_0ocreo2">
      <bpmn:incoming>Flow_0v9t1jd</bpmn:incoming>
      <bpmn:outgoing>Flow_1717vq2</bpmn:outgoing>
      <bpmn:outgoing>Flow_0bnqrih</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_1717vq2" sourceRef="Gateway_0ocreo2" targetRef="Task_Store_Queued_Task" />
    <bpmn:sequenceFlow id="Flow_0v9t1jd" sourceRef="Task_Enqueue_Celery" targetRef="Gateway_0ocreo2" />
    <bpmn:sequenceFlow id="Flow_0bnqrih" sourceRef="Gateway_0ocreo2" targetRef="Task_Return_Task_Id" />
    <bpmn:exclusiveGateway id="Gateway_1y6lyrq">
      <bpmn:incoming>Flow_052ambf</bpmn:incoming>
      <bpmn:incoming>Flow_9b</bpmn:incoming>
      <bpmn:outgoing>Flow_1el5msz</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_052ambf" sourceRef="Task_Filter_Existing" targetRef="Gateway_1y6lyrq" />
    <bpmn:sequenceFlow id="Flow_1el5msz" sourceRef="Gateway_1y6lyrq" targetRef="Task_Create_Chunks" />
  </bpmn:process>
