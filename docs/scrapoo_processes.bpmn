<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Scrapoo_Processes" targetNamespace="https://scrapoo.local/bpmn" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <bpmn:process id="Process_Analytics_Request" name="Analyticka poziadavka z dashboardu" isExecutable="false">
    <bpmn:documentation>
      Proces opisuje bezny tok, pri ktorom pouzivatel v Streamlit dashboarde vyberie analyticku sekciu a system zobrazi vysledky nacitane z FastAPI backendu.
    </bpmn:documentation>
    <bpmn:startEvent id="Analytics_Start" name="Pouzivatel otvori dashboard">
      <bpmn:outgoing>Flow_Analytics_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Analytics_Select_View" name="Vyber zdroja dat z analytickej sekcie">
      <bpmn:incoming>Flow_Analytics_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Analytics_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Analytics_Request_API" name="Dashboard odosle REST poziadavku">
      <bpmn:incoming>Flow_Analytics_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Analytics_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Analytics_Read_Data" name="Backend nacita data z vybranej databazy">
      <bpmn:incoming>Flow_Analytics_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Analytics_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0li294k">
        <bpmn:targetRef>DataStoreReference_1f7wipv</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Analytics_Graph_Required" name="Je pozadovana grafova analyza?">
      <bpmn:incoming>Flow_Analytics_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Analytics_5a</bpmn:outgoing>
      <bpmn:outgoing>Flow_Analytics_5b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Analytics_Compute_Graph" name="Vypocet grafovych metrik">
      <bpmn:incoming>Flow_Analytics_5a</bpmn:incoming>
      <bpmn:outgoing>Flow_Analytics_6a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Analytics_Prepare_Response" name="Priprava JSON odpovede">
      <bpmn:incoming>Flow_184e3ke</bpmn:incoming>
      <bpmn:outgoing>Flow_Analytics_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Analytics_Render_Dashboard" name="Zobrazenie tabuliek a grafov v dashboarde">
      <bpmn:incoming>Flow_Analytics_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Analytics_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Analytics_End" name="Analyticky vystup zobrazeny">
      <bpmn:incoming>Flow_Analytics_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Analytics_1" sourceRef="Analytics_Start" targetRef="Analytics_Select_View" />
    <bpmn:sequenceFlow id="Flow_Analytics_2" sourceRef="Analytics_Select_View" targetRef="Analytics_Request_API" />
    <bpmn:sequenceFlow id="Flow_Analytics_3" sourceRef="Analytics_Request_API" targetRef="Analytics_Read_Data" />
    <bpmn:sequenceFlow id="Flow_Analytics_4" sourceRef="Analytics_Read_Data" targetRef="Analytics_Graph_Required" />
    <bpmn:sequenceFlow id="Flow_Analytics_5a" name="ano" sourceRef="Analytics_Graph_Required" targetRef="Analytics_Compute_Graph" />
    <bpmn:sequenceFlow id="Flow_Analytics_5b" name="nie" sourceRef="Analytics_Graph_Required" targetRef="Gateway_1f8jy38" />
    <bpmn:sequenceFlow id="Flow_Analytics_6a" sourceRef="Analytics_Compute_Graph" targetRef="Gateway_1f8jy38" />
    <bpmn:sequenceFlow id="Flow_Analytics_7" sourceRef="Analytics_Prepare_Response" targetRef="Analytics_Render_Dashboard" />
    <bpmn:sequenceFlow id="Flow_Analytics_8" sourceRef="Analytics_Render_Dashboard" targetRef="Analytics_End" />
    <bpmn:exclusiveGateway id="Gateway_1f8jy38" name="Je pozadovana grafova analyza?">
      <bpmn:incoming>Flow_Analytics_6a</bpmn:incoming>
      <bpmn:incoming>Flow_Analytics_5b</bpmn:incoming>
      <bpmn:outgoing>Flow_184e3ke</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_184e3ke" sourceRef="Gateway_1f8jy38" targetRef="Analytics_Prepare_Response" />
    <bpmn:dataStoreReference id="DataStoreReference_1f7wipv" />
    <bpmn:textAnnotation id="TextAnnotation_1w4lwrk">
      <bpmn:text>doplnit</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0p9ovbm" associationDirection="None" sourceRef="DataStoreReference_1f7wipv" targetRef="TextAnnotation_1w4lwrk" />
  </bpmn:process>
  <bpmn:process id="Process_CSFD_Scraping" name="Ziskavanie dat z CSFD" isExecutable="false">
    <bpmn:documentation>
      Proces opisuje spustenie CSFD scrapingu cez API, delegovanie dlhej operacie do Celery workera, crawling pomocou Scrapy a ulozenie dat do PostgreSQL databazy.
    </bpmn:documentation>
    <bpmn:startEvent id="CSFD_Start" name="Administrator spusti CSFD scraping">
      <bpmn:outgoing>Flow_CSFD_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="CSFD_Validate_Request" name="API validuje parametre poziadavky">
      <bpmn:incoming>Flow_CSFD_1</bpmn:incoming>
      <bpmn:outgoing>Flow_CSFD_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CSFD_Resolve_Sitemap" name="Nacitanie a vyber sitemap suborov">
      <bpmn:incoming>Flow_CSFD_2</bpmn:incoming>
      <bpmn:outgoing>Flow_CSFD_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CSFD_Sitemap_Available" name="Su dostupne sitemap URL?">
      <bpmn:incoming>Flow_CSFD_3</bpmn:incoming>
      <bpmn:outgoing>Flow_CSFD_4a</bpmn:outgoing>
      <bpmn:outgoing>Flow_CSFD_4b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CSFD_Enqueue_Task" name="Zaradenie Celery ulohy">
      <bpmn:incoming>Flow_CSFD_4a</bpmn:incoming>
      <bpmn:outgoing>Flow_CSFD_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CSFD_Expand_Seeds" name="Worker rozsiri sitemap na URL filmov">
      <bpmn:incoming>Flow_CSFD_5</bpmn:incoming>
      <bpmn:outgoing>Flow_CSFD_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CSFD_Crawl" name="Scrapy spracuje filmove stranky">
      <bpmn:incoming>Flow_CSFD_6</bpmn:incoming>
      <bpmn:outgoing>Flow_CSFD_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CSFD_Persist" name="Ulozenie filmov, osob a vztahov">
      <bpmn:incoming>Flow_CSFD_7</bpmn:incoming>
      <bpmn:outgoing>Flow_CSFD_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CSFD_Report_Status" name="Spristupnenie stavu ulohy cez API">
      <bpmn:incoming>Flow_CSFD_8</bpmn:incoming>
      <bpmn:outgoing>Flow_CSFD_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CSFD_End_Success" name="CSFD data ulozene">
      <bpmn:incoming>Flow_CSFD_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CSFD_End_Error" name="Poziadavka odmietnuta">
      <bpmn:incoming>Flow_CSFD_4b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CSFD_1" sourceRef="CSFD_Start" targetRef="CSFD_Validate_Request" />
    <bpmn:sequenceFlow id="Flow_CSFD_2" sourceRef="CSFD_Validate_Request" targetRef="CSFD_Resolve_Sitemap" />
    <bpmn:sequenceFlow id="Flow_CSFD_3" sourceRef="CSFD_Resolve_Sitemap" targetRef="CSFD_Sitemap_Available" />
    <bpmn:sequenceFlow id="Flow_CSFD_4a" name="ano" sourceRef="CSFD_Sitemap_Available" targetRef="CSFD_Enqueue_Task" />
    <bpmn:sequenceFlow id="Flow_CSFD_4b" name="nie" sourceRef="CSFD_Sitemap_Available" targetRef="CSFD_End_Error" />
    <bpmn:sequenceFlow id="Flow_CSFD_5" sourceRef="CSFD_Enqueue_Task" targetRef="CSFD_Expand_Seeds" />
    <bpmn:sequenceFlow id="Flow_CSFD_6" sourceRef="CSFD_Expand_Seeds" targetRef="CSFD_Crawl" />
    <bpmn:sequenceFlow id="Flow_CSFD_7" sourceRef="CSFD_Crawl" targetRef="CSFD_Persist" />
    <bpmn:sequenceFlow id="Flow_CSFD_8" sourceRef="CSFD_Persist" targetRef="CSFD_Report_Status" />
    <bpmn:sequenceFlow id="Flow_CSFD_9" sourceRef="CSFD_Report_Status" targetRef="CSFD_End_Success" />
  </bpmn:process>
  <bpmn:process id="Process_TMDB_Ingestion" name="Import dat z TMDB" isExecutable="false">
    <bpmn:documentation>
      Proces opisuje import filmov z TMDB API do samostatnej TMDB PostgreSQL databazy.
    </bpmn:documentation>
    <bpmn:startEvent id="TMDB_Start" name="Administrator spusti TMDB import">
      <bpmn:outgoing>Flow_TMDB_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="TMDB_Enqueue" name="API zaradi Celery ulohu">
      <bpmn:incoming>Flow_TMDB_1</bpmn:incoming>
      <bpmn:outgoing>Flow_TMDB_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TMDB_Check_Config" name="Worker overi TMDB konfiguraciu">
      <bpmn:incoming>Flow_TMDB_2</bpmn:incoming>
      <bpmn:outgoing>Flow_TMDB_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TMDB_Config_OK" name="Je dostupny API kluc alebo token?">
      <bpmn:incoming>Flow_TMDB_3</bpmn:incoming>
      <bpmn:outgoing>Flow_TMDB_4a</bpmn:outgoing>
      <bpmn:outgoing>Flow_TMDB_4b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TMDB_Fetch" name="Nacitanie filmov a credits z TMDB API">
      <bpmn:incoming>Flow_TMDB_4a</bpmn:incoming>
      <bpmn:outgoing>Flow_TMDB_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TMDB_Map" name="Transformacia na interny datovy model">
      <bpmn:incoming>Flow_TMDB_5</bpmn:incoming>
      <bpmn:outgoing>Flow_TMDB_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="TMDB_Persist" name="Ulozenie do TMDB databazy">
      <bpmn:incoming>Flow_TMDB_6</bpmn:incoming>
      <bpmn:outgoing>Flow_TMDB_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="TMDB_End_Success" name="TMDB import dokonceny">
      <bpmn:incoming>Flow_TMDB_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="TMDB_End_Error" name="Import zlyhal na konfiguracii">
      <bpmn:incoming>Flow_TMDB_4b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TMDB_1" sourceRef="TMDB_Start" targetRef="TMDB_Enqueue" />
    <bpmn:sequenceFlow id="Flow_TMDB_2" sourceRef="TMDB_Enqueue" targetRef="TMDB_Check_Config" />
    <bpmn:sequenceFlow id="Flow_TMDB_3" sourceRef="TMDB_Check_Config" targetRef="TMDB_Config_OK" />
    <bpmn:sequenceFlow id="Flow_TMDB_4a" name="ano" sourceRef="TMDB_Config_OK" targetRef="TMDB_Fetch" />
    <bpmn:sequenceFlow id="Flow_TMDB_4b" name="nie" sourceRef="TMDB_Config_OK" targetRef="TMDB_End_Error" />
    <bpmn:sequenceFlow id="Flow_TMDB_5" sourceRef="TMDB_Fetch" targetRef="TMDB_Map" />
    <bpmn:sequenceFlow id="Flow_TMDB_6" sourceRef="TMDB_Map" targetRef="TMDB_Persist" />
    <bpmn:sequenceFlow id="Flow_TMDB_7" sourceRef="TMDB_Persist" targetRef="TMDB_End_Success" />
  </bpmn:process>
  <bpmn:process id="Process_Person_Enrichment" name="Obohatenie osob z CSFD" isExecutable="false">
    <bpmn:documentation>
      Proces opisuje doplnkove obohatenie existujucich osob, ktore boli predtym vytvorene ako stubs pocas filmoveho scrapingu.
    </bpmn:documentation>
    <bpmn:startEvent id="People_Start" name="Administrator spusti obohatenie osob">
      <bpmn:outgoing>Flow_People_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="People_Enqueue" name="API zaradi enrichment ulohu">
      <bpmn:incoming>Flow_People_1</bpmn:incoming>
      <bpmn:outgoing>Flow_People_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="People_Select" name="Worker vyberie osoby na obohatenie">
      <bpmn:incoming>Flow_People_2</bpmn:incoming>
      <bpmn:outgoing>Flow_People_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="People_Crawl" name="Crawling detailov osob z CSFD">
      <bpmn:incoming>Flow_People_3</bpmn:incoming>
      <bpmn:outgoing>Flow_People_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="People_Update" name="Aktualizacia udajov osob v databaze">
      <bpmn:incoming>Flow_People_4</bpmn:incoming>
      <bpmn:outgoing>Flow_People_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="People_End" name="Osoby obohatene">
      <bpmn:incoming>Flow_People_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_People_1" sourceRef="People_Start" targetRef="People_Enqueue" />
    <bpmn:sequenceFlow id="Flow_People_2" sourceRef="People_Enqueue" targetRef="People_Select" />
    <bpmn:sequenceFlow id="Flow_People_3" sourceRef="People_Select" targetRef="People_Crawl" />
    <bpmn:sequenceFlow id="Flow_People_4" sourceRef="People_Crawl" targetRef="People_Update" />
    <bpmn:sequenceFlow id="Flow_People_5" sourceRef="People_Update" targetRef="People_End" />
  </bpmn:process>
