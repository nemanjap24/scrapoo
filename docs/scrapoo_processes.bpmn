  <bpmndi:BPMNDiagram id="Diagram_CSFD_Scraping" name="Ziskavanie dat z CSFD">
    <bpmndi:BPMNPlane id="Plane_CSFD_Scraping" bpmnElement="Process_CSFD_Scraping">
      <bpmndi:BPMNShape id="Shape_CSFD_Start" bpmnElement="CSFD_Start">
        <dc:Bounds x="100" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
